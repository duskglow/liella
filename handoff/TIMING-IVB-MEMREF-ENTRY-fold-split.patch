From b2b290de3b0895a051f742eeaebb04c885d63a6d Mon Sep 17 00:00:00 2001
From: Liella Maintainers <liella@koiren.ai>
Date: Fri, 6 Nov 2026 11:15:28 +0000
Subject: [PATCH] Store six blocks per end for SSE2 129-192 copy and fill

On the SSE2 build the memmove and memset 129-256 classes stored eight
16-byte blocks from each end at every size: 16 stores. Ivy Bridge
retires one store per cycle, so that count is the class's floor. For
129-192 six blocks from each end already cover the region; 193-256
keeps eight. This is ruling #3421's provisional split, rebased by hand
onto the folded 129-256 copy gate (NULLFOLD-COPY-MID-3): the gate is
unchanged, the split sits after it, and every load still precedes the
first store. Timing on the Ivy Bridge and N100 hosts decides whether it
stays (the 193-256 rows gain one compare).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 csys/src/machine/fold.S | 56 +++++++++++++++++++++++++++++++++++------
 1 file changed, 48 insertions(+), 8 deletions(-)

diff --git a/csys/src/machine/fold.S b/csys/src/machine/fold.S
index 37cd5408..f229e8c0 100644
--- a/csys/src/machine/fold.S
+++ b/csys/src/machine/fold.S
@@ -32,7 +32,8 @@
 	.hidden liella_hot_fill_large
 
 /* void *liella_machine_memmove(void *d, const void *s, size_t n): 129-256 (folded with NULL folding
- * on, see .Lmove_129) four 32-byte blocks from each end (AVX2) or eight 16-byte ones (SSE2), 65-128 two
+ * on, see .Lmove_129) four 32-byte blocks from each end (AVX2) or six (129-192) or eight 16-byte
+ * ones (SSE2), 65-128 two
  * 32-byte blocks from each end (AVX2) or four 16-byte ones (SSE2), 33-64 two
  * 16-byte blocks from each end, 16-32 one from each end, 8-15 two 8-byte words, 4-7 two 4-byte words, 2-3 two 2-byte
  * words, 1 one byte, 0 nothing; other sizes in Rust. */
@@ -108,7 +109,7 @@ memcpy:
  * 129-256 folded (below: no NULL test while `liella_machine_move_long` is nonzero), with AVX2 (the flag byte below,
  * or for 129-256 the class word's clear sign bit, set by crates/boundary/src/dispatch.rs only when the CPU has AVX2
  * and the OS saves the YMM state) two
- * (65-128) or four (129-256) 32-byte blocks from each end, without it four or eight 16-byte ones;
+ * (65-128) or four (129-256) 32-byte blocks from each end, without it four or six (129-192) or eight 16-byte ones;
  * a NULL, 1-64 without folding and every other size in Rust. The 65-128 class falls through
  * (no compare added to it by COPY-256). */
 .Lmove_big:
@@ -188,7 +189,38 @@ memcpy:
 	btrq $63, %rcx			/* the SSE2 mark off: 256 */
 	cmpq %rcx, %rdx
 	ja liella_hot_move_rest
+/* TIMING-IVB-MEMREF-ENTRY: 129-192 six 16-byte blocks from each end (the whole region for
+ * n <= 192; 12 loads and 12 stores, not 16 each), 193-256 eight from each end. The ORDER above
+ * holds on both paths: all loads, starting at s + 0, before the first store at d + 0. */
 .Lmove_129_sse2:
+	cmpq $192, %rdx
+	ja .Lmove_193_sse2
+	movups (%rsi), %xmm0
+	movups 16(%rsi), %xmm1
+	movups 32(%rsi), %xmm2
+	movups 48(%rsi), %xmm3
+	movups 64(%rsi), %xmm4
+	movups 80(%rsi), %xmm5
+	movups -96(%rsi,%rdx), %xmm6
+	movups -80(%rsi,%rdx), %xmm7
+	movups -64(%rsi,%rdx), %xmm8
+	movups -48(%rsi,%rdx), %xmm9
+	movups -32(%rsi,%rdx), %xmm10
+	movups -16(%rsi,%rdx), %xmm11
+	movups %xmm0, (%rdi)
+	movups %xmm1, 16(%rdi)
+	movups %xmm2, 32(%rdi)
+	movups %xmm3, 48(%rdi)
+	movups %xmm4, 64(%rdi)
+	movups %xmm5, 80(%rdi)
+	movups %xmm6, -96(%rdi,%rdx)
+	movups %xmm7, -80(%rdi,%rdx)
+	movups %xmm8, -64(%rdi,%rdx)
+	movups %xmm9, -48(%rdi,%rdx)
+	movups %xmm10, -32(%rdi,%rdx)
+	movups %xmm11, -16(%rdi,%rdx)
+	ret
+.Lmove_193_sse2:
 	movups (%rsi), %xmm0
 	movups 16(%rsi), %xmm1
 	movups 32(%rsi), %xmm2
@@ -277,8 +309,8 @@ __mempcpy:
 
 /* void *liella_machine_memset(void *d, int c, size_t n), (unsigned char)c: 16 and more bytes take
  * (unsigned char)c in all 16 bytes of xmm0 (movd, punpcklbw, pshuflw, punpcklqdq: the low byte
- * only, whatever the int's other bytes) and store 16-byte blocks from each end (1, 2, 4 or 8 per end
- * for 16-32, 33-64, 65-128, 129-256; with AVX2 129-256 four 32-byte blocks per end instead); 8-15 two 4-byte words from each end, 4-7 one 4-byte word from each
+ * only, whatever the int's other bytes) and store 16-byte blocks from each end (1, 2, 4, 6 or 8 per end
+ * for 16-32, 33-64, 65-128, 129-192, 193-256; with AVX2 129-256 four 32-byte blocks per end instead); 8-15 two 4-byte words from each end, 4-7 one 4-byte word from each
  * end, 2-3 one 2-byte word from each end, 1 one byte, 0 nothing; other sizes in Rust. */
 	.section .text.liella_machine_memset,"ax",@progbits
 	.globl liella_machine_memset
@@ -386,6 +418,10 @@ memset:
 	vmovdqu %ymm0, -32(%rdi,%rdx)
 	vzeroupper
 	ret
+/* TIMING-IVB-MEMREF-ENTRY: six 16-byte blocks from each end ([d, d + 96) and [d + n - 96, d + n),
+ * the whole region for n <= 192), then for 193-256 the two more from each end that reach
+ * [d + 96, d + n - 96). 129-192 stores 12 blocks, not 16 (one store per cycle on the SSE2-only
+ * hosts measured: the store count was the class's floor). */
 .Lset_129_sse2:
 	movd %esi, %xmm0
 	punpcklbw %xmm0, %xmm0
@@ -397,16 +433,20 @@ memset:
 	movups %xmm0, 48(%rdi)
 	movups %xmm0, 64(%rdi)
 	movups %xmm0, 80(%rdi)
-	movups %xmm0, 96(%rdi)
-	movups %xmm0, 112(%rdi)
-	movups %xmm0, -128(%rdi,%rdx)
-	movups %xmm0, -112(%rdi,%rdx)
 	movups %xmm0, -96(%rdi,%rdx)
 	movups %xmm0, -80(%rdi,%rdx)
 	movups %xmm0, -64(%rdi,%rdx)
 	movups %xmm0, -48(%rdi,%rdx)
 	movups %xmm0, -32(%rdi,%rdx)
 	movups %xmm0, -16(%rdi,%rdx)
+	cmpq $192, %rdx
+	ja .Lset_193_sse2
+	ret
+.Lset_193_sse2:
+	movups %xmm0, 96(%rdi)
+	movups %xmm0, 112(%rdi)
+	movups %xmm0, -128(%rdi,%rdx)
+	movups %xmm0, -112(%rdi,%rdx)
 	ret
 /* MEMSET-4K-3: above 256 the kernel choice here, as `hot::bulk_fill` makes it: from the `rep stosb`
  * word (`liella_machine_fill_erms_from`, at least 257; usize::MAX without ERMS or before the
-- 
2.43.0

