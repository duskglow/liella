 // ------------------------------------------------------------------------------ §15.8
 
+// The rcmd family is a set of stubs (D-15.8-STUB, owner rulings R10/R11 2026-11-04): the
+// connecting calls fail like the secure-RPC stubs (`-1`, `errno` `EOPNOTSUPP`, D-29.3) without a
+// socket, a lookup or a write through any argument; the trust checks always deny (`-1`, `errno`
+// untouched: a refusal is an answer, not an error), so address-based trust never succeeds while a
+// module that links them (pam_rhosts) still loads.
+
+/// The connecting calls' failure: `-1` with `errno` `EOPNOTSUPP` (the D-29.3 rule).
+fn rcmd_unsupported() -> c_int {
+    crate::errno::set_raw(crate::posix::s29_rpc_auth::EOPNOTSUPP);
+    -1
+}
