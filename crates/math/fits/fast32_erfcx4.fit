# LIBM-F32-ERF (D-10.3): erfcx = erfc(x)·e^(x²) on [81/16, 243/32], piece 4 of the `float` erfc kernel
# (pieces grow by 3/2 up to 243/32, then 37/4: erfc x is below 2^-126 beyond 9.19). Centred on the
# midpoint; degree 15 from trial fits (degree 12 lost 2^3.5 per piece, 2^-45 by the fourth).
name = fast32_erfcx4
target = erfcx
interval = -81/128, 81/128
shift = 405/64
powers = 0..15
error = relative
format = f64
output = crates/math/src/coeffs/fast32_erfcx4.rs
