# LIBM-F32-GAMMA (D-10.3): lnΓ(1 + z) = z q(z) on [-1/8, 1/8], the `float` log-gamma kernel near its
# zeros x = 1 (z = x - 1) and x = 2 (lnΓ(2 + z) = ln(1 + z) + z q(z), z = x - 2), both z exact.
# Relative error of q (q(0) = -γ, no zero on the interval), so z q(z) has the same relative error.
name = fast32_lgamma
target = lgamma1p_over_x
interval = -1/8, 1/8
powers = 0..11
error = relative
format = f64
output = crates/math/src/coeffs/fast32_lgamma.rs
